#!/bin/bash
# Performance Deity Pre-Commit Hook
# Place this in your .git/hooks/ directory

echo -e "\e[36m[Performance Deity] Running Pre-Commit Performance Audit...\e[0m"

# In a real scenario, this would detect the changed files and run their associated benchmark scripts.
# For now, it serves as a strict reminder to run the optimizer.

# Example strict check: Look for TODOs related to performance
if git diff --cached | grep -q -i "TODO: optimize"; then
    echo -e "\e[31m[ERROR] Performance Deity detected unoptimized code ('TODO: optimize').\e[0m"
    echo -e "Run '/plugin performance-deity:optimize' before committing."
    exit 1
fi

echo -e "\e[32m[OK] Code meets Performance Deity standards.\e[0m"
exit 0
